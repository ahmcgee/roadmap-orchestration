{
  "$comment": "Output schema for the Phase-0 cross-model PLAN-PACK REVIEW (SKILL.md → Phase 0 → 'Cross-model review of the plan pack'). OpenAI strict mode: every property is required at every level and additionalProperties is false, or `codex exec --output-schema` 400s (evals/README.md P1). Every cap here is restated in phase0-review-brief.md — a cap the model is never told is a trap (RATIONALE §9). Pinned by evals/unit/phase0-templates.test.mjs.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "contradictions": {
      "type": "array",
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "between": { "type": "string", "maxLength": 200 },
          "what": { "type": "string", "maxLength": 400 },
          "evidence": { "type": "string", "maxLength": 300 }
        },
        "required": ["between", "what", "evidence"]
      }
    },
    "unbuildable": {
      "type": "array",
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "unit": { "type": "string", "maxLength": 60 },
          "why": { "type": "string", "maxLength": 400 },
          "question": { "type": "string", "maxLength": 300 }
        },
        "required": ["unit", "why", "question"]
      }
    },
    "recut": {
      "type": "array",
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "units": { "type": "string", "maxLength": 200 },
          "proposal": { "type": "string", "maxLength": 400 },
          "why": { "type": "string", "maxLength": 300 }
        },
        "required": ["units", "proposal", "why"]
      }
    },
    "briefDefects": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "command": { "type": "string", "maxLength": 300 },
          "observed": { "type": "string", "maxLength": 300 }
        },
        "required": ["command", "observed"]
      }
    },
    "questions": {
      "type": "array",
      "maxItems": 12,
      "items": { "type": "string", "maxLength": 300 }
    },
    "notes": { "type": "string", "maxLength": 600 }
  },
  "required": ["contradictions", "unbuildable", "recut", "briefDefects", "questions", "notes"]
}
