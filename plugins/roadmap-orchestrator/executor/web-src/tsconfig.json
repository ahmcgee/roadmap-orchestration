{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "lib": [
      "es2024",
      "DOM",
      "DOM.Iterable"
    ],
    "jsx": "react-jsx",
    "module": "esnext",
    "moduleResolution": "bundler",
    "types": [
      "react",
      "react-dom",
      "node"
    ]
  },
  "include": [
    "./**/*.ts",
    "./**/*.tsx"
  ],
  "exclude": [
    "../node_modules"
  ]
}
