{
  "name": "roadmap-executor",
  "version": "1.0.0-dev.55",
  "private": true,
  "type": "module",
  "description": "roadmap-orchestrator 1.0 executor: a plain Node process that owns backends, git and the event log. Runs on Node 24 type stripping; no runtime dependencies.",
  "engines": {
    "node": ">=24.21"
  },
  "scripts": {
    "typecheck": "tsc --noEmit && tsc --noEmit -p web-src/tsconfig.json",
    "test": "node --test --test-concurrency=8 test/*.test.ts && node --test --test-concurrency=1 test/serial/*.test.ts",
    "probe": "node evals/probe.ts",
    "build:console": "node scripts/build-console.ts"
  },
  "devDependencies": {
    "@fontsource/barlow": "5.3.0",
    "@fontsource/barlow-semi-condensed": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@tailwindcss/cli": "4.3.3",
    "@tanstack/react-virtual": "3.14.22",
    "@types/node": "24.13.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "cytoscape": "3.34.4",
    "echarts": "6.1.0",
    "esbuild": "0.28.2",
    "lucide-react": "1.61.0",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "7.0.2"
  }
}
